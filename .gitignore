# Python
__pycache__/
*.pyc
.venv/

# Laufzeitdaten - nicht Teil des Projekts, riesig und maschinenspezifisch
models/
logs/

# Selbst quantisierte Modellgewichte (mehrere zig GB, siehe
# docs/anleitung-eigene-awq-quantisierung.md zum Nachbauen statt Committen)
models-quantized/

# Eigenes venv zum Quantisieren - nur das Skript selbst tracken, nicht die
# venv-Inhalte (Interpreter/Packages, maschinenspezifisch, mehrere GB)
.venv-quantize/*
!.venv-quantize/quantize_qwen38.py

# Lokale, ggf. sensible Konfiguration (API-Key, HF-Token, absolute Pfade).
# Vorlage siehe config.example.json.
config.json

# Automatische Backups des Config-Editors (vllm_manager/config_editor.py) -
# enthalten dieselben sensiblen Daten wie config.json.
config_backups/

# Persistente Kostentracking-Historie (vllm_manager/cost_tracker.py) - reine
# Nutzungsdaten dieser Maschine, nicht Teil des Projekts.
costs.jsonl
costs.jsonl.tmp

# Zeiger aufs zuletzt genutzte Modell fürs automatische Nachladen beim
# Dienststart (vllm_manager/process_manager.py, config.auto_reload_last_model).
last_active_model.json
last_active_model.json.tmp

# Laufende Downloads fürs automatische Fortsetzen nach 'systemctl restart'
# (vllm_manager/downloader.py resume_pending_downloads) - enthält ggf. einen
# HF-Token im Klartext, wie config.json auch.
pending_downloads.json
pending_downloads.json.tmp

# Zwischenablage der NVFP4-Selbstquantisierung (vllm_manager/nvfp4_quantizer.py)
# - wird nach jedem Job aufgeräumt, nur als Absicherung gegen Leichen bei
# einem Absturz mitten im Lauf.
quantize_output/

# Claude Code lokale Projekt-Settings (Permissions dieser Maschine)
.claude/settings.local.json

# Alte, archivierte Skripte mit früher hartkodiertem API-Key im Klartext
archive/Anleitung.txt.alt
archive/setup_hermes_service.sh
