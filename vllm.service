[Unit]
Description=vLLM Manager (auto-loading OpenAI-kompatibler Server + MCP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mwagner
Group=mwagner
WorkingDirectory=/home/mwagner/vllm
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/mwagner/vllm/.venv/bin/python -m vllm_manager
Restart=on-failure
RestartSec=5
# Der Manager-Prozess selbst startet sofort; einzelne Modelle laden erst bei
# Bedarf im Hintergrund (siehe startup_timeout_seconds in config.json).
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
